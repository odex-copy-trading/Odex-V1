# Multi-stage Dockerfile for the Rust trading engine (`whal-engine`) on Railway.
FROM rust:1.85-slim AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY engine/Cargo.toml engine/Cargo.lock ./engine/
COPY engine/whal-config ./engine/whal-config
COPY engine/src ./engine/src

WORKDIR /app/engine
RUN cargo build --release --bin whal-engine

FROM debian:bookworm-slim AS runner
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/engine/target/release/whal-engine /usr/local/bin/whal-engine

ENV RUST_LOG=info
ENV PORT=9100
EXPOSE 9100

CMD ["whal-engine"]
