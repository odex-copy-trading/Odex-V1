    "exits": {
      "type": "object",
      "properties": {
        "instant_tp_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "ladder": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sell_pct": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "trigger": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "pnl_multiple"
                      },
                      "value": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1000
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "time_secs"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 86400
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "sell_pct",
              "trigger"
            ],
            "additionalProperties": false
          }
        },
        "stop_loss_pct": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 99
            },
            {
              "type": "null"
            }
          ]
        },
        "trailing_stop_pct": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 99
            },
            {
              "type": "null"
            }
          ]
