    "network": {
      "type": "object",
      "properties": {
        "rpc_primary_url": {
          "type": "string"
        },
        "rpc_backup_urls": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geyser_grpc_url": {
          "type": "string"
        },
        "shredstream_url": {
          "type": "string"
        },
        "commitment": {
          "type": "string",
          "enum": [
            "processed",
            "confirmed",
            "finalized"
          ]
        },
        "slot_clock_offset_ms": {
          "type": "integer",
          "minimum": -2000,
          "maximum": 2000
        }
      },
      "required": [
        "rpc_primary_url",
        "rpc_backup_urls",
        "geyser_grpc_url",
        "shredstream_url",
        "commitment",
        "slot_clock_offset_ms"
